<launch>
  <!-- ip of the computer on which the bridge is running -->
  <arg name="bridge_ip" default="172.17.0.1"/>
  <!-- ip of the computer, on which the navigator software is running -->
  <arg name="nav_ip" default="127.0.0.1"/>
  <arg name="loc_ip" default="172.17.0.1"/>

  <!-- name of the node -->
  <arg name="bridge_node_name" default="navigator_bridge_node"/>
  <!--ports-->
  
  <arg name="nav_binary_ports_start" default="9104"/>
  <arg name="nav_rpc_port" default="8180"/>

  <!-- login credentials for the navigator software -->
  <arg name="nav_user" default="admin"/>
  <arg name="nav_password" default="admin"/>

  <arg name="odom_topic" default="odom"/>
  <arg name="cmd_vel_topic" default="cmd_vel"/>

<!-- Odometry Pose Set (fieldMask) -->
<arg name="odometry_pose_set" default="false" description="set to true if the pose in the odometry should be used"/>


<!--Motion Feedback Port-->
  <arg name="feedback_datagram_port" default="1211"/>

  
<!--Client Localization Port-->
  <arg name="localization_datagram_port" default="9011"/>
  
<!--Client Localization Map Port-->  
 <arg name="map_datagram_port" default="9009"/> 

  <node pkg="bosch_navigator_bridge" exec="navigator_bridge_node" name="$(var bridge_node_name)" output="screen">
    <param name="nav_host" value="$(var nav_ip)" />
    <param name="nav_rpc_port" value="$(var nav_rpc_port)" />
    <param name="nav_binary_ports_start" value="$(var nav_binary_ports_start)" />
    <param name="feedback_datagram_port" value="$(var feedback_datagram_port)"/>
    <param name="user_name" value="$(var nav_user)"/>
    <param name="password" value="$(var nav_password)"/>
    <param name="odometry_pose_set" value="$(var odometry_pose_set)"/>
    <remap from="odom" to="$(var odom_topic)" />
    <remap from="cmd_vel" to="$(var cmd_vel_topic)"/>

 <param name="navigator_client_config">
  <!--Client Motion-->
  <!--Feedback-->
  <param name="ClientMotion.feedback.address" value= "$(var bridge_ip):1211"/>
  <!--Client Localization-->
  <param name="ClientLocalization.pose.address" value="127.0.0.1:9011"/>
  <!--Client Localization Map-->
  <param name="ClientLocalization.map.address" value="172.17.0.1:9009"/>
  <!--Client Motion Navigation Default Node Deviation-->
  <param name="ClientMotion.navigation.defaultNodeDeviationXY" value="0.3"/>
  <!--Client Motion vehicle footprint-->
  <param name="ClientMotion.vehicle.footprint" value="[  0.089,  0.069,  -0.089,  0.069,  -0.089,  -0.069,  0.089,  -0.069]"/>
  <!--Client Motion vehicle kinematics Typ-->
  <param name="ClientMotion.vehicle.kinematicsType" value="DIFFERENTIAL_DRIVE"/>

  <!--Client Motion vehicle enable Wheel1-->
  <param name="ClientMotion.vehicle.enableWheel1" value="true"/>
  <!--Client Motion vehicle enable Wheel2-->
  <param name="ClientMotion.vehicle.enableWheel2" value="true"/>
  <!--Client Motion vehicle enable Wheel3-->
  <param name="ClientMotion.vehicle.enableWheel3" value="false"/>
  <!--Client Motion vehicle enable Wheel4-->
  <param name="ClientMotion.vehicle.enableWheel4" value="false"/>

  <!--Client Motion vehicle wheel1 powered-->
  <param name="ClientMotion.vehicle.wheel1.powered" value="true"/>
  <!--ClientMotion vehicle wheel1 steered-->
  <param name="ClientMotion.vehicle.wheel1.steered" value="false"/>
  <!--Client Motion vehicle wheel1 vehicle Transform Wheel x-->
  <param name="ClientMotion.vehicle.wheel1.vehicleTransformWheel.x" value="0.0"/>
  <!--Client Motion vehicle wheel1 vehicle Transform Wheel y-->
  <param name="ClientMotion.vehicle.wheel1.vehicleTransformWheel.y" value="0.08"/>
  <!--Client Motion vehicle wheel1 vehicle Transform Wheel yaw-->
  <param name="ClientMotion.vehicle.wheel1.vehicleTransformWheel.yaw" value="0.0"/>

  <!--ClientMotion vehicle wheel2 powered-->
  <param name="ClientMotion.vehicle.wheel1.powered" value="true"/>
  <!--ClientMotion vehicle wheel2 steered-->
  <param name="ClientMotion.vehicle.wheel1.steered" value="false"/>
  <!--Client Motion vehicle wheel2 vehicle Transform Wheel x-->
  <param name="ClientMotion.vehicle.wheel2.vehicleTransformWheel.x" value="0.0"/>
  <!--Client Motion vehicle wheel2 vehicle Transform Wheel y-->
  <param name="ClientMotion.vehicle.wheel2.vehicleTransformWheel.y" value="-0.08"/>
    <!--Client Motion vehicle wheel2 vehicle Transform Wheel yaw-->
  <param name="ClientMotion.vehicle.wheel2.vehicleTransformWheel.yaw" value="0.0"/>

  <!--ClientMotion vehicle wheel3 powered-->
  <param name="ClientMotion.vehicle.wheel3.powered" value="false"/>
  <!--ClientMotion vehicle wheel3 steered-->
  <param name="ClientMotion.vehicle.wheel3.steered" value="false"/>
  <!--ClientMotion vehicle wheel4 powered-->
  <param name="ClientMotion.vehicle.wheel4.powered" value="false"/>
  <!--ClientMotion vehicle wheel4 steered-->
  <param name="ClientMotion.vehicle.wheel4.steered" value="false"/>

  <!--Client Order vda5050 mqtt server-->
  <param name="ClientOrder.vda5050.mqtt.server" value="tcp://172.17.0.1:1883"/>
  <!--Client Motion Safety laser1 Protection Fields-->
  <param name="ClientMotion.safety.laser1ProtectionFieldsBase64 " value=""/>
  
  <!--Client Sensor laser1 address-->
  <param name="ClientSensor.laser1.address" value="172.17.0.1:9021"/>
  <!--Cient Sensor laser1 vehicle Transform Laser x-->
  <param name="ClientSensor.laser1.vehicleTransformLaser.x" value="-0.012"/>
  <!--Cient Sensor laser1 vehicle Transform Laser y-->
  <param name="ClientSensor.laser1.vehicleTransformLaser.y" value="0.0"/>
  <!--Cient Sensor laser1 vehicle Transform Laser yaw-->
  <param name="ClientSensor.laser1.vehicleTransformLaser.yaw" value="0.0"/>

</param>
</node>
</launch>
